COMPOSE_PROJECT_NAME=claude-agent-harness

# Domestic dependency mirrors; replace when deploying outside mainland China.
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

POSTGRES_PASSWORD=replace-with-a-long-password
MINIO_ROOT_USER=harness-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-password

# Anthropic-compatible model gateway. These values are deliberately non-functional.
HARNESS_NEW_API_BASE_URL=http://host.docker.internal:3001
HARNESS_NEW_API_KEY=replace-with-new-api-key
HARNESS_NEW_API_MODEL=deepseek-chat
HARNESS_API_BEARER_TOKEN=replace-with-at-least-32-random-characters
# Declare only capabilities verified by scripts/smoke_new_api.py for this model route.
HARNESS_NEW_API_COMPATIBILITY=full
HARNESS_NEW_API_CAPABILITIES=streaming,tool_use

# Optional official Anthropic fallback for manifests with fallbackRoute.
HARNESS_ANTHROPIC_BASE_URL=https://api.anthropic.com
HARNESS_ANTHROPIC_API_KEY=
HARNESS_ANTHROPIC_MODEL=

HARNESS_SANDBOX_PROVIDER=daytona
HARNESS_ALLOW_UNSAFE_LOCAL_SANDBOX=false
HARNESS_DAYTONA_API_KEY=
HARNESS_DAYTONA_API_URL=https://app.daytona.io/api
HARNESS_DAYTONA_REMOTE_WORKSPACE_ROOT=/home/daytona/harness
HARNESS_DAYTONA_CLAUDE_CLI_VERSION=2.1.206
HARNESS_DAYTONA_CLAUDE_CLI_PATH=/home/daytona/.local/bin/claude
HARNESS_DAYTONA_DELETE_ON_DESTROY=true
HARNESS_DAYTONA_AUTO_STOP_INTERVAL_MINUTES=15
HARNESS_DAYTONA_AUTO_DELETE_INTERVAL_MINUTES=60
HARNESS_WORKER_TASK_VISIBILITY_TIMEOUT_SECONDS=60
HARNESS_WORKER_TASK_RETRY_DELAY_SECONDS=1
HARNESS_WORKER_TASK_HEARTBEAT_SECONDS=20
HARNESS_WORKSPACE_ARCHIVE_MAX_BYTES=536870912
HARNESS_WORKSPACE_ARCHIVE_MAX_MEMBERS=10000
HARNESS_DAYTONA_TARGET=
HARNESS_DAYTONA_SNAPSHOT=

HARNESS_MCP_SECRET_REFERENCES_JSON={}
HARNESS_MCP_SERVER_SECRETS_JSON={}

# Enable together with: docker compose --profile observability up -d
HARNESS_OTEL_ENABLED=false
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_ENVIRONMENT=production

HARNESS_TENANT_ID=local
HARNESS_USER_ID=developer
HARNESS_AGENT_NAME=echo-agent
HARNESS_AGENT_VERSION=0.4.0
