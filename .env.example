HARNESS_ENVIRONMENT=local
HARNESS_RUNTIME=fake
HARNESS_API_BEARER_TOKEN=
HARNESS_AUTH_JWT_SECRET=local-development-auth-secret-change-before-production
HARNESS_AUTH_ALLOW_REGISTRATION=true
HARNESS_AUTH_DEFAULT_TENANT_ID=local
HARNESS_AUTH_GOOGLE_CLIENT_ID=
HARNESS_AUTH_GOOGLE_CLIENT_SECRET=
HARNESS_AUTH_GITHUB_CLIENT_ID=
HARNESS_AUTH_GITHUB_CLIENT_SECRET=
HARNESS_ALLOW_UNSAFE_LOCAL_SANDBOX=false
HARNESS_OTEL_ENABLED=false
HARNESS_LOCAL_AUTO_EXECUTE=false

# Next.js BFF only. Identity never ships in the browser bundle.
HARNESS_API_URL=http://127.0.0.1:8000
HARNESS_AGENT_NAME=echo-agent
HARNESS_AGENT_VERSION=0.4.0
HARNESS_TENANT_ID=local
HARNESS_USER_ID=developer
COPILOTKIT_TELEMETRY_DISABLED=true

HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness
HARNESS_REDIS_URL=redis://localhost:6379/0

HARNESS_MINIO_ENDPOINT=localhost:9000
HARNESS_MINIO_ACCESS_KEY=minioadmin
HARNESS_MINIO_SECRET_KEY=change-me
HARNESS_MINIO_BUCKET=harness-artifacts
HARNESS_MINIO_SECURE=false

# Optional live model smoke test. Leave empty for normal local development.
HARNESS_NEW_API_BASE_URL=
HARNESS_NEW_API_KEY=
HARNESS_NEW_API_MODEL=
HARNESS_NEW_API_COMPATIBILITY=full
HARNESS_NEW_API_CAPABILITIES=streaming,tool_use
HARNESS_ANTHROPIC_BASE_URL=https://api.anthropic.com
HARNESS_ANTHROPIC_API_KEY=
HARNESS_ANTHROPIC_MODEL=

# Production-only observability template. Local development leaves this empty.
HARNESS_OTLP_ENDPOINT=
HARNESS_OTLP_HEADERS=
HARNESS_OTEL_SERVICE_NAME=claude-agent-harness

# Optional OTel Collector -> Langfuse export. Keep authorization server-side.
# LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_ENDPOINT=
LANGFUSE_AUTHORIZATION=
